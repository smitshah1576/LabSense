@startuml exp6-dfd-level1
' Rectangle = external entity, ellipse = process, cylinder = data store.
title LabSense - DFD Level 1

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #EEF2F7
  BorderColor #1F2933
  BorderThickness 2
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  BorderThickness 2
}
skinparam database {
  BackgroundColor #FFF8E6
  BorderColor #8C6D1F
}
skinparam ArrowColor #1F2933

rectangle "Student" as Student
rectangle "Professor" as Professor
rectangle "Admin" as Admin
rectangle "Lab PC Agent" as Agent

usecase "1.0\nLog In" as P1
usecase "2.0\nProcess\nPC Status" as P2
usecase "3.0\nShow Live\nLab Status" as P3
usecase "4.0\nSearch\nSoftware" as P4
usecase "5.0\nManage Labs\n& Timetable" as P5
usecase "6.0\nHandle Damage\nReports" as P6

database "D1  Users" as D1
database "D2  PCs" as D2
database "D3  Labs & Timetable" as D3
database "D4  Damage Reports" as D4

Student --> P1 : login details
Professor --> P1 : login details
Admin --> P1 : login details
D1 --> P1 : user record
P1 --> P3 : verified user

Agent --> P2 : PC status
P2 --> Agent : rejection notice
P2 --> D2 : PC state & software

D2 --> P3 : PC states
D3 --> P3 : lab hours & timetable
P3 --> Student : live lab status
P3 --> Professor : live lab status
P3 --> Admin : live lab status

Student --> P4 : software search
D2 --> P4 : installed software
P4 --> Student : search results

Admin --> P5 : lab & PC details
Professor --> P5 : slot cancellation
P5 --> D3 : labs & timetable
P5 --> D2 : new PC

Student --> P6 : damage report
Professor --> P6 : maintenance request
Admin --> P6 : report decision
P6 --> Admin : damage reports
P6 <--> D4 : reports
P6 --> D2 : maintenance flag
@enduml
