@startuml uml-deployment
' UML Deployment Diagram: where each part of LabSense runs and how they talk.
title LabSense - Deployment Diagram

skinparam shadowing false
skinparam node {
  BackgroundColor #F5F8FC
  BorderColor #3A6EA5
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}
skinparam database {
  BackgroundColor #FFF8E6
  BorderColor #8C6D1F
}

node "Lab PC (Ubuntu 22.04 / 24.04)" as LabPC <<device>> {
  node "systemd" as Systemd <<execution environment>> {
    component "labsense-agent\n(Python asyncio service)" as Agent
  }
  component "systemd-logind" as Logind <<OS service>>
  artifact "/dev/input/event*" as Input
}

node "Lab Server" as Server <<device>> {
  node "Uvicorn, 1 worker" as Uvicorn <<execution environment>> {
    component "FastAPI app\n(REST + WebSocket)" as Api
    component "TCP heartbeat server\n(asyncio streams)" as Tcp
    component "PCStateManager\n(in-memory store)" as State
  }
  node "Docker" as Docker <<execution environment>> {
    database "PostgreSQL 16\n(labsense-db)" as Db
  }
  node "Vite / static web server" as Web <<execution environment>> {
    artifact "React SPA bundle" as Spa
  }
}

node "User device" as Client <<device>> {
  node "Web browser" as Browser <<execution environment>> {
    component "LabSense dashboard\n(React)" as Dashboard
  }
}

Agent --> Tcp : TCP :9000\nlength-prefixed JSON\n(HEARTBEAT, GOING_TO_SLEEP,\nSOFTWARE_REPORT / REJECTED)
Agent ..> Logind : D-Bus system bus\n(sleep, lock, session)
Agent ..> Input : reads event timing
Tcp --> State
Api --> State
Api --> Db : asyncpg :5432
Tcp --> Db : asyncpg :5432
Dashboard --> Api : HTTP :8000 REST\n(JWT bearer)
Dashboard <-- Api : WebSocket :8000/ws\n(live pc_update)
Web ..> Dashboard : serves SPA\nHTTP :5173

LabPC "1..*" -- "1" Server : campus LAN
Client "0..*" -- "1" Server : campus LAN
@enduml
