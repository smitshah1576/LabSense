@startuml uml-state-machine-pc
' UML State Machine Diagram: lifecycle of one lab PC as the server tracks it
' (backend/app/state/pc_state_manager.py).
title LabSense - State Machine Diagram: PC State

skinparam shadowing false
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}
hide empty description

[*] --> Automatic : PC registered by admin

state "Automatic (agent-driven)" as Automatic {
  state "AVAILABLE" as AVAILABLE : free to use\n(also covers powered off /\ndisconnected PCs)
  state "IN_USE" as IN_USE : someone is using it
  state "AVAILABLE_SLEEP" as SLEEP : shown as "Asleep"\nno staleness timeout

  [*] --> AVAILABLE
  AVAILABLE --> IN_USE : heartbeat [inUse]
  IN_USE --> AVAILABLE : heartbeat [not inUse]
  IN_USE --> AVAILABLE : after(15 s) with no heartbeat
  AVAILABLE --> SLEEP : GOING_TO_SLEEP
  IN_USE --> SLEEP : GOING_TO_SLEEP
  SLEEP --> IN_USE : heartbeat [inUse]
  SLEEP --> AVAILABLE : heartbeat [not inUse]
}

state "MAINTENANCE" as MAINTENANCE : heartbeat / record telemetry only\nGOING_TO_SLEEP / ignored\nno staleness timeout

Automatic --> MAINTENANCE : tag maintenance (professor/admin)\nor damage report approved (admin)
MAINTENANCE --> AVAILABLE : clear maintenance

Automatic --> [*] : PC deregistered
MAINTENANCE --> [*] : PC deregistered

note as InUseRule
  <b>in-use rule</b>
  inUse = session_active AND
    ( idle_seconds < 300
      OR CPU > 5 % in each of the last 3 heartbeats
      OR screen locked for < 15 min )
end note
@enduml
