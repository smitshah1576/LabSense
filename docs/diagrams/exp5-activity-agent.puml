@startuml exp5-activity-agent
' Experiment 5 - Activity Diagram: agent lifecycle on a lab PC.
' The fork is genuine: the agent runs these as concurrent asyncio tasks.
title LabSense - Activity Diagram: Lab PC Agent Lifecycle

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  DiamondBackgroundColor #F5F8FC
}

start
:Load configuration
(server host/port, pc_id, intervals);
:Start input-idle tracker
(/dev/input events);
:Acquire logind sleep inhibitor lock;
note right
  Times out after 5 s; the agent
  continues without the lock
  rather than failing to start.
end note
:Connect to server TCP :9000;

fork
  partition "Heartbeat task" {
    repeat
      if (connected?) then (no)
        :Reconnect with back-off
        (5 s doubling to 60 s);
      else (yes)
        :Collect telemetry;
        :Send HEARTBEAT;
        :Wait 5 s;
      endif
    repeat while (cancelled?) is (no)
    ->yes;
  }
fork again
  partition "D-Bus task (supervised)" {
    repeat
      :Connect to system D-Bus;
      :Wait for logind signal;
      if (PrepareForSleep(true)?) then (yes)
        :Send GOING_TO_SLEEP;
        :Drain send buffer;
        :Release inhibitor lock;
      elseif (PrepareForSleep(false)?) then (yes)
        :Re-acquire inhibitor lock;
        :Reconnect to server;
      else (bus lost)
        :Retry with back-off
        (heartbeats unaffected);
      endif
    repeat while (cancelled?) is (no)
    ->yes;
  }
fork again
  partition "Software-scan task" {
    repeat
      if (connected?) then (yes)
        :Scan dpkg -l and pip list;
        :Send SOFTWARE_REPORT;
      else (no)
      endif
      :Wait 300 s;
    repeat while (cancelled?) is (no)
    ->yes;
  }
fork again
  partition "Shutdown watcher" {
    :Wait for SIGTERM / SIGINT;
  }
end fork {or: heartbeat task ends\nor a stop signal arrives}

:Cancel remaining tasks;
:Close TCP connection;
:Release inhibitor lock;
stop
@enduml
