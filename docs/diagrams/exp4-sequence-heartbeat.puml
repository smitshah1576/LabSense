@startuml exp4-sequence-heartbeat
' Experiment 4 - Sequence Diagram: a heartbeat travels from a lab PC to every dashboard
title LabSense - Sequence Diagram: Heartbeat to Live Dashboard

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber "<b>[0]"

actor "Lab PC Agent" as Agent
boundary ":HeartbeatServer\n(TCP :9000)" as TCP
control ":PCStateManager" as SM
entity ":PCLiveState" as LS
control ":ConnectionManager" as WS
database "PostgreSQL" as DB
actor "Dashboard\n(browser)" as UI

loop every 5 s while the PC is on
  Agent -> Agent : collect telemetry\n(CPU %, session, lock, idle)
  Agent ->> TCP : HEARTBEAT(pc_id, session_active,\nscreen_locked, idle_seconds, cpu_percent)
  activate TCP

  opt first message for this pc_id on the connection
    TCP -> DB : SELECT 1 FROM pcs WHERE pc_id = ?
    DB --> TCP : registered / not found
  end

  alt pc_id is not registered
    TCP ->> Agent : REJECTED(pc_id, reason)
    TCP -> TCP : close connection
  else pc_id is registered
    TCP -> SM : handleHeartbeat(pc_id, telemetry)
    activate SM
    SM -> LS : recordTelemetry(telemetry, now)

    alt current state is MAINTENANCE
      SM -> SM : resetStalenessTimer(pc_id)
      note right of SM : automatic transitions suppressed;\ntelemetry is still recorded
    else any other state
      SM -> LS : isInUse(now)
      activate LS
      LS --> SM : session_active AND (input < 300 s\nOR CPU > 5 % for 3 beats OR locked < 15 min)
      deactivate LS
      SM -> SM : newState = IN_USE or AVAILABLE;\nresetStalenessTimer(pc_id) (15 s)

      opt newState != oldState
        SM -> WS : broadcastPcUpdate(pc_id, newState)
        WS ->> UI : pc_update {pc_id, state}
        SM -> DB : INSERT state_transitions;\nUPDATE pcs SET current_state
      end
    end

    SM --> TCP : transition or none
    deactivate SM
    TCP -> SM : getState(pc_id)
    SM --> TCP : live state
    TCP -> WS : broadcastPcHeartbeat(pc_id, state, telemetry)
    WS ->> UI : pc_update {pc_id, state, cpu, idle, session, lock}
    UI -> UI : re-render PC card
  end
  deactivate TCP
end

== Heartbeats stop (power loss, frozen OS, cable pulled) ==

... 15 s with no heartbeat ...

SM -> SM : stalenessTimeout(pc_id)
activate SM
opt state is not MAINTENANCE or AVAILABLE_SLEEP
  SM -> WS : broadcastPcUpdate(pc_id, AVAILABLE)
  WS ->> UI : pc_update {pc_id, AVAILABLE}
  SM -> DB : INSERT state_transitions (-> AVAILABLE)
end
deactivate SM
@enduml
