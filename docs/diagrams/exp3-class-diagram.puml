@startuml exp3-class-diagram
title LabSense - Class Diagram

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}
hide empty members

abstract class User {
  - name : String
  - email : String
  + login() : Boolean
}

class Student {
  + reportDamage(pc : PC) : DamageReport
}

class Professor {
  + setMaintenance(pc : PC) : void
  + cancelSlot(slot : TimetableSlot) : void
}

class Admin {
  + registerPC(lab : Lab) : PC
  + reviewReport(report : DamageReport) : void
}

class Lab {
  - labId : String
  - name : String
  - openingHours : String
  + getLabState() : String
}

class PC {
  - pcId : String
  - state : PCState
  - installedSoftware : List<String>
  + updateState(hb : Heartbeat) : void
  + hasSoftware(name : String) : Boolean
}

class TimetableSlot {
  - day : String
  - startTime : Time
  - endTime : Time
  - courseCode : String
  + cancelFor(date : Date) : void
}

class DamageReport {
  - description : String
  - status : String
  + approve() : void
  + dismiss() : void
}

class Agent {
  - pcId : String
  + collectStatus() : Heartbeat
  + sendHeartbeat() : void
}

class Heartbeat {
  - cpuPercent : float
  - idleSeconds : int
  - sessionActive : Boolean
  - screenLocked : Boolean
}

enum PCState {
  AVAILABLE
  IN_USE
  ASLEEP
  MAINTENANCE
}

User <|-- Student
User <|-- Professor
User <|-- Admin

Lab "1" o-- "0..*" PC : contains
Lab "1" *-- "0..*" TimetableSlot : has
Student "1" -- "0..*" DamageReport : files
DamageReport "0..*" -- "1" PC : about
Agent "1" -- "1" PC : monitors
Agent ..> Heartbeat : sends
PC ..> PCState
@enduml
