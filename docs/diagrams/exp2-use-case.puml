@startuml exp2-use-case
title LabSense - Use Case Diagram

left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}

actor Student
actor Professor
actor Admin
actor "Lab PC Agent" as Agent <<system>>

Admin -|> Professor

rectangle "LabSense System" {
  usecase "Log In" as Login
  usecase "View Live Lab\n& PC Status" as View
  usecase "Search Software" as Search
  usecase "Report Damaged PC" as Report
  usecase "Tag PC for\nMaintenance" as Maint
  usecase "Cancel Timetable\nSlot" as Cancel
  usecase "Manage Labs & PCs" as Manage
  usecase "Review Damage\nReports" as Review
  usecase "Send PC Status" as Status
}

Student --> Login
Student --> View
Student --> Search
Student --> Report

Professor --> Login
Professor --> View
Professor --> Maint
Professor --> Cancel

Admin --> Manage
Admin --> Review

Status <-- Agent

View ..> Login : <<include>>
Maint .> Review : <<extend>>
@enduml
