@startuml exp6-dfd-level0
' Rectangle = external entity, ellipse = process, arrow = data flow.
title LabSense - DFD Level 0 (Context Diagram)

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #EEF2F7
  BorderColor #1F2933
  BorderThickness 2
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  BorderThickness 2
}
skinparam ArrowColor #1F2933

rectangle "Lab PC Agent" as Agent
rectangle "Student" as Student
rectangle "Professor" as Professor
rectangle "Admin" as Admin

usecase "0\n\nLabSense\nSystem" as P0

Agent -right-> P0 : PC status
P0 -left-> Agent : rejection notice

Student -down-> P0 : login details\nsoftware search\ndamage report
P0 -up-> Student : live lab status\nsearch results

Professor -left-> P0 : login details\nmaintenance request\nslot cancellation
P0 -right-> Professor : live lab status

Admin -up-> P0 : login details\nlab & PC details\nreport decision
P0 -down-> Admin : live lab status\ndamage reports
@enduml
