@startuml exp6-dfd-level0
' Experiment 6 - DFD Level 0 (Context Diagram)
' Notation: rectangle = external entity, ellipse = process, arrow = data flow.
title LabSense - DFD Level 0 (Context Diagram)

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #EEF2F7
  BorderColor #1F2933
  BorderThickness 2
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  BorderThickness 2
}
skinparam ArrowColor #1F2933

rectangle "Lab PC Agent" as Agent
rectangle "Student" as Student
rectangle "Professor" as Professor
rectangle "Admin" as Admin

usecase "0\n\nLabSense\nLab Monitoring\nSystem" as P0

Agent -right-> P0 : heartbeat telemetry\nsleep notice\nsoftware inventory
P0 -left-> Agent : rejection notice

Student -down-> P0 : login credentials\nsoftware query\ndamage report
P0 -up-> Student : auth token\nlive lab & PC status\nsoftware search results

Professor -left-> P0 : login credentials\nmaintenance toggle\nslot cancellation
P0 -right-> Professor : auth token\nlive lab & PC status\nlab timetable

Admin -up-> P0 : login credentials\nlab & PC registration\ntimetable entries\nreport decision\nmaintenance toggle
P0 -down-> Admin : auth token\nlive lab & PC status\npending damage reports
@enduml
