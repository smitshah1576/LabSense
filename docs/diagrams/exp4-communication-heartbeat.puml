@startuml exp4-communication-heartbeat
' Communication diagram for the same interaction as exp4-sequence-heartbeat:
' objects and their links, with numbered messages (nesting = call depth).
title LabSense - Communication Diagram: Heartbeat to Live Dashboard

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
}

actor "Lab PC Agent" as Agent
rectangle ":HeartbeatServer" as TCP
rectangle ":PCStateManager" as SM
rectangle ":PCLiveState" as LS
rectangle ":ConnectionManager" as WS
database "PostgreSQL" as DB
actor "Dashboard\n(browser)" as UI

Agent -right- TCP : "1: HEARTBEAT(pc_id, telemetry) →\n← 1.1a ~[not registered]: REJECTED(pc_id, reason)"
TCP -down- DB : "↓ 1.1 ~[first message]: isRegistered(pc_id)"
TCP -right- SM : "1.2: handleHeartbeat(pc_id, telemetry) →\n1.3: getState(pc_id) →"
SM -right- LS : "1.2.1: recordTelemetry(telemetry, now) →\n1.2.2: isInUse(now) →"
SM -down- WS : "↓ 1.2.3 ~[state changed]: broadcastPcUpdate(pc_id, state)"
SM -down- DB : "↓ 1.2.4 ~[state changed]: insertTransition(pc_id, old, new)"
TCP -down- WS : "↓ 1.4: broadcastPcHeartbeat(pc_id, state, telemetry)"
WS -down- UI : "↓ 1.2.3.1: pc_update(pc_id, state)\n↓ 1.4.1: pc_update(pc_id, state, telemetry)"

note bottom of UI
  Guards match the sequence diagram:
  1.1 runs once per pc_id per connection;
  1.2.2 is skipped while the PC is in MAINTENANCE;
  1.2.3 and 1.2.4 run only when the state changes.
end note
@enduml
