@startuml exp5-activity-heartbeat
' Experiment 5 - Activity Diagram (swimlanes): processing one heartbeat
title LabSense - Activity Diagram: Processing a Heartbeat

skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #3A6EA5
  DiamondBackgroundColor #F5F8FC
}
skinparam swimlane {
  BorderColor #9AA5B1
  TitleFontStyle bold
}

' Declare lanes up front so they appear in this order.
|Lab PC Agent|
|Heartbeat Server|
|PC State Manager|
|Database|
|Dashboard|

|Lab PC Agent|
start
repeat
  :Collect telemetry
  (CPU %, session, lock, idle time);
  :Send HEARTBEAT frame
  to server TCP :9000;

  |Heartbeat Server|
  :Read length-prefixed JSON frame;
  if (pc_id already validated\non this connection?) then (no)
    |Database|
    :Look up pc_id in pcs table;
    |Heartbeat Server|
  else (yes)
  endif

  if (pc_id registered?) then (no)
    :Send REJECTED reply;
    :Close the connection;
    |Lab PC Agent|
    :Log "pc_id not registered";
    stop
  else (yes)
  endif

  |PC State Manager|
  :Record telemetry and CPU sample;
  if (current state = MAINTENANCE?) then (yes)
    :Keep MAINTENANCE
    (no automatic transition);
  else (no)
    if (session active?) then (no)
      :New state = AVAILABLE;
    elseif (input < 300 s OR CPU > 5 % for\n3 heartbeats OR locked < 15 min?) then (yes)
      :New state = IN_USE;
    else (no)
      :New state = AVAILABLE;
    endif
    if (state changed?) then (yes)
      |Dashboard|
      :Receive pc_update (new state);
      |Database|
      :Insert state_transitions row;
      :Update pcs.current_state;
      |PC State Manager|
    else (no)
    endif
  endif
  :Restart 15 s staleness timer;

  |Heartbeat Server|
  :Broadcast telemetry snapshot;
  |Dashboard|
  :Re-render the PC card;

  |Lab PC Agent|
  :Wait 5 s;
repeat while (agent still running?) is (yes)
->no;
stop
@enduml
