#!/usr/bin/env python3
"""pcctl — drive the testbed's simulated lab PCs and see what the server made of it.

    pcctl status                      fleet table: what each PC is doing vs. the server's view
    pcctl wait [--timeout N]          block until the server has a fresh heartbeat from every PC

    pcctl <pc> scenario <name>        in-use | idle | locked | cpu-busy | logged-out
    pcctl <pc> sleep                  clean suspend (GOING_TO_SLEEP)   -> AVAILABLE_SLEEP
    pcctl <pc> power-off              abrupt power loss                -> AVAILABLE after 15 s
    pcctl <pc> hang                   frozen, socket still open        -> AVAILABLE after 15 s
    pcctl <pc> wake | power-on        resume heartbeats
    pcctl <pc> software               resend the SOFTWARE_REPORT now

    pcctl <pc> unplug | replug        pull / reinsert the network cable (docker network)
    pcctl <pc> stop | start           stop / start the whole container (agent service stop)

<pc> is 1-5, pc-3, lab-a-pc-3, or `all` (every mock PC).  The scenario and
power commands need a mock PC (1-4); lab-a-pc-5 runs the real agent and only
takes unplug/replug/stop/start.

Environment: LABSENSE_API (default http://localhost:8000), LABSENSE_ADMIN_EMAIL,
LABSENSE_ADMIN_PASSWORD.  Standard library only.
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

# Mirrors testbed/compose.yml.
LAN = 'labsense-lan'
FLEET = [
    # pc_id,        kind,    control port, lab LAN IP
    ('lab-a-pc-1', 'mock', 7001, '172.28.0.11'),
    ('lab-a-pc-2', 'mock', 7002, '172.28.0.12'),
    ('lab-a-pc-3', 'mock', 7003, '172.28.0.13'),
    ('lab-a-pc-4', 'mock', 7004, '172.28.0.14'),
    ('lab-a-pc-5', 'agent', None, '172.28.0.15'),
]
LAB_ID = 'lab-a'

API = os.environ.get('LABSENSE_API', 'http://localhost:8000').rstrip('/')
ADMIN_EMAIL = os.environ.get('LABSENSE_ADMIN_EMAIL', 'admin@labsense.dev')
ADMIN_PASSWORD = os.environ.get('LABSENSE_ADMIN_PASSWORD', 'password123')
# Matches the backend's HEARTBEAT_TIMEOUT_SECONDS: older than this, the
# server has already given up on the PC.
FRESH_SECONDS = 15

MOCK_ACTIONS = {'sleep', 'wake', 'power-on', 'power-off', 'hang', 'software'}
DOCKER_ACTIONS = {'unplug', 'replug', 'stop', 'start'}


class CtlError(Exception):
    pass


# -- helpers ----------------------------------------------------------------

def _http(method: str, url: str, body: dict | None = None, token: str | None = None,
          timeout: float = 5.0) -> dict | list:
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header('Content-Type', 'application/json')
    if token:
        req.add_header('Authorization', f'Bearer {token}')
    # The testbed is all local; never route it through an outbound proxy.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b'null')
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors='replace')
        raise CtlError(f'{method} {url} -> HTTP {exc.code}: {detail}') from None
    except (urllib.error.URLError, OSError) as exc:
        raise CtlError(f'{method} {url} -> {getattr(exc, "reason", exc)}') from None


def resolve(arg: str) -> list[tuple]:
    if arg == 'all':
        return [pc for pc in FLEET if pc[1] == 'mock']
    key = arg.removeprefix('lab-a-').removeprefix('pc-').removeprefix('pc')
    for pc in FLEET:
        if pc[0].endswith(f'-{key}'):
            return [pc]
    raise CtlError(f'unknown PC {arg!r} — use 1-5, pc-N, lab-a-pc-N or all')


def server_view() -> dict[str, dict]:
    token = _http('POST', f'{API}/auth/login',
                  {'email': ADMIN_EMAIL, 'password': ADMIN_PASSWORD})['access_token']
    pcs = _http('GET', f'{API}/labs/{LAB_ID}/pcs', token=token)
    return {pc['pc_id']: pc for pc in pcs}


def heartbeat_age(pc: dict) -> float | None:
    ts = pc.get('last_heartbeat_at')
    if not ts:
        return None
    then = datetime.fromisoformat(ts.replace('Z', '+00:00'))
    if then.tzinfo is None:
        then = then.replace(tzinfo=timezone.utc)
    return (datetime.now(timezone.utc) - then).total_seconds()


def container_state(name: str) -> str:
    try:
        out = subprocess.run(['docker', 'inspect', '-f', '{{.State.Status}}', name],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return '?'
    return out.stdout.strip() if out.returncode == 0 else 'absent'


def on_lan(name: str) -> bool:
    out = subprocess.run(['docker', 'inspect', '-f', '{{json .NetworkSettings.Networks}}', name],
                         capture_output=True, text=True)
    return out.returncode == 0 and LAN in json.loads(out.stdout or '{}')


def docker(*args: str) -> None:
    out = subprocess.run(['docker', *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise CtlError(f'docker {" ".join(args)}: {out.stderr.strip()}')


# -- commands ---------------------------------------------------------------

def cmd_status() -> int:
    try:
        server = server_view()
        server_err = None
    except CtlError as exc:
        server, server_err = {}, str(exc)

    print(f'Fleet ({LAB_ID}):  client side                          │  server side')
    header = (f'  {"PC":<11} {"kind":<6} {"container":<9} {"LAN":<9} {"scenario":<10} {"power":<6} {"hb":>5}'
              f' │ {"state":<15} {"idle":>6} {"cpu":>6} {"last hb":>8}')
    print(header)
    print('  ' + '─' * (len(header) - 2))
    for pc_id, kind, port, _ip in FLEET:
        cstate = container_state(pc_id)
        lan = 'on' if cstate == 'running' and on_lan(pc_id) else ('UNPLUGGED' if cstate == 'running' else '-')
        scenario = power = hb = '-'
        if lan == 'UNPLUGGED':
            scenario = '(offline)'  # its control API went with the cable
        elif port and cstate == 'running':
            try:
                st = _http('GET', f'http://127.0.0.1:{port}/status', timeout=2)
                scenario, power, hb = st['scenario'], st['power'], str(st['heartbeats_sent'])
                if st.get('rejected'):
                    power = 'REJECT'
            except CtlError:
                scenario = '(no API)'
        elif kind == 'agent':
            scenario = '(real)'

        srv = server.get(pc_id, {})
        age = heartbeat_age(srv) if srv else None
        idle = srv.get('idle_seconds')
        cpu = srv.get('cpu_percent')
        print(f'  {pc_id:<11} {kind:<6} {cstate:<9} {lan:<9} {scenario:<10} {power:<6} {hb:>5}'
              f' │ {srv.get("current_state", "?"):<15}'
              f' {"-" if idle is None else f"{idle}s":>6}'
              f' {"-" if cpu is None else f"{cpu:.0f}%":>6}'
              f' {"never" if age is None else f"{age:.0f}s ago":>8}')
    if server_err:
        print(f'\n  server view unavailable: {server_err}')
    return 0


def cmd_wait(argv: list[str]) -> int:
    timeout = float(argv[argv.index('--timeout') + 1]) if '--timeout' in argv else 60.0
    deadline = time.monotonic() + timeout
    missing: list[str] = [pc[0] for pc in FLEET]
    last_err = None
    while time.monotonic() < deadline:
        try:
            server = server_view()
            missing = [pc_id for pc_id, *_ in FLEET
                       if (age := heartbeat_age(server.get(pc_id, {}))) is None or age > FRESH_SECONDS]
            last_err = None
            if not missing:
                print(f'all {len(FLEET)} fleet PCs have a heartbeat within the last {FRESH_SECONDS}s')
                return 0
        except CtlError as exc:
            last_err = str(exc)
        time.sleep(1)
    print(f'timed out after {timeout:.0f}s; no fresh heartbeat from: {", ".join(missing)}'
          + (f'\nlast error: {last_err}' if last_err else ''), file=sys.stderr)
    return 1


def cmd_pc(target: str, action: str, rest: list[str]) -> int:
    pcs = resolve(target)
    for pc_id, kind, port, ip in pcs:
        if action == 'scenario' or action in MOCK_ACTIONS:
            if kind != 'mock':
                raise CtlError(f'{pc_id} runs the real agent; it only takes: {", ".join(sorted(DOCKER_ACTIONS))}')
            if action == 'scenario':
                if not rest:
                    raise CtlError('usage: pcctl <pc> scenario <in-use|idle|locked|cpu-busy|logged-out>')
                path = f'scenario/{rest[0]}'
            else:
                path = action
            st = _http('POST', f'http://127.0.0.1:{port}/{path}')
            print(f'{pc_id}: scenario={st["scenario"]} power={st["power"]} connected={st["connected"]}'
                  + ('  (GOING_TO_SLEEP sent)' if st.get('going_to_sleep_sent') else ''))
        elif action == 'unplug':
            docker('network', 'disconnect', LAN, pc_id)
            print(f'{pc_id}: network cable pulled (off {LAN})')
        elif action == 'replug':
            docker('network', 'connect', '--ip', ip, LAN, pc_id)
            print(f'{pc_id}: network cable back in ({ip} on {LAN})')
        elif action in ('stop', 'start'):
            docker(action, pc_id)
            print(f'{pc_id}: container {"stopped" if action == "stop" else "started"}')
        else:
            raise CtlError(f'unknown action {action!r}')
    return 0


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__)
        return 0
    try:
        if argv[0] == 'status':
            return cmd_status()
        if argv[0] == 'wait':
            return cmd_wait(argv[1:])
        if len(argv) < 2:
            raise CtlError('usage: pcctl <pc> <action> [args]  (see pcctl --help)')
        return cmd_pc(argv[0], argv[1], argv[2:])
    except CtlError as exc:
        print(f'pcctl: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    # Die quietly when piped into head/grep -m, like other Unix tools.
    if hasattr(signal, 'SIGPIPE'):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    sys.exit(main(sys.argv[1:]))
