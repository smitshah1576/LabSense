# LabSense testbed - server settings.
#
# The testbed's copy of backend\.env on the Windows server: the same LABSENSE_*
# variables in the same .env syntax, loaded into the same Settings class
# (backend/app/config.py). Anything not set here keeps its default, exactly as
# it would on Windows.
#
# The one setting a LAN deployment cannot do without: every URL the dashboard
# is opened from must be listed, including http://<server-LAN-IP>:5173 for
# anyone browsing from another device on the Wi-Fi. Here the server's LAN IP
# is 172.28.0.1, its address on the testbed's lab network. On the real server,
# substitute its Wi-Fi IP (SETUP_WINDOWS_SERVER.md, Phase 0.1).
# 172.28.0.2 is the testbed's Wi-Fi emulator (testbed.sh wifi): browsing via it puts
# the dashboard behind the emulated Wi-Fi too. Not needed on the real server.
LABSENSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://172.28.0.1:5173","http://172.28.0.2:5173"]
