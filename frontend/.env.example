# LabSense frontend configuration.
#
# Copy to `.env` only if you need to override the defaults. By default the
# dashboard talks to port 8000 on whatever host served it, which is correct
# when the backend and Vite run on the same machine (including over the LAN).
#
# Set these when the backend lives somewhere else — e.g. Vite running on your
# laptop against a backend on the lab server.

# REST API base URL (include the scheme).
# VITE_API_URL=http://10.234.237.199:8000

# WebSocket host:port (no scheme — ws:// or wss:// is chosen automatically
# based on how the dashboard itself was loaded).
# VITE_WS_URL=10.234.237.199:8000
