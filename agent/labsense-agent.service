[Unit]
Description=LabSense PC Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=labsense
Environment=LABSENSE_SERVER_HOST=192.168.1.100
Environment=LABSENSE_SERVER_PORT=9000
Environment=LABSENSE_PC_ID=lab-a-pc-1
ExecStart=/opt/labsense-agent/.venv/bin/python3 -m labsense_agent.main
WorkingDirectory=/opt/labsense-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
