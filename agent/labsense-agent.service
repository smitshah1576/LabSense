[Unit]
Description=LabSense PC Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=labsense
# Read access to /dev/input/event* for precise idle time (timing only).
SupplementaryGroups=input
# /run/labsense/maintenance.json is read by the desktop notifier, which runs
# as the logged-in user, so the directory must be world-readable.
RuntimeDirectory=labsense
RuntimeDirectoryMode=0755
Environment=LABSENSE_SERVER_HOST=192.168.1.100
Environment=LABSENSE_SERVER_PORT=9000
Environment=LABSENSE_PC_ID=lab-a-pc-1
ExecStart=/opt/labsense-agent/.venv/bin/python3 -m labsense_agent.main
WorkingDirectory=/opt/labsense-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
